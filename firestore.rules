rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /games/{gameId} {
      // Public game status and player count only. Secret word is never stored here.
      allow read: if signedIn();
      allow write: if false;

      match /roster/{playerUid} {
        // Names and join order are visible in the lobby.
        allow read: if signedIn();
        allow write: if false;
      }

      match /privatePlayers/{playerUid} {
        // Each player can read only their own role and word.
        allow read: if signedIn() && request.auth.uid == playerUid;
        allow write: if false;
      }

      match /hostSecret/{secretId} {
        // Only Admin SDK Cloud Functions can read/write this document.
        allow read, write: if false;
      }
    }
  }
}
