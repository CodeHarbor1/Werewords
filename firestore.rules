rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;
      match /roster/{playerId} { allow read: if signedIn(); allow write: if false; }
      match /privatePlayers/{playerId} { allow read: if signedIn() && resource.data.uid == request.auth.uid; allow write: if false; }
      match /hostSecret/{secretId} { allow read, write: if false; }
    }
  }
}
